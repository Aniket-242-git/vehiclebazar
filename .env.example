# =============================================================================
# Environment variable template - copy to .env and fill in real values.
# NEVER commit the real .env file (it is already in .gitignore).
# =============================================================================

# --- Django core --------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# --- DATABASE -----------------------------------------------------------------
#
# DEVELOPMENT: you do NOT need any DB_* variables.
#   python manage.py runserver  (uses config.settings.development -> SQLite,
#   file: db.sqlite3 created automatically next to manage.py)
#
# PRODUCTION (cPanel MySQL): settings module config.settings.production reads:
DB_ENGINE=django.db.backends.mysql
DB_NAME=cpaneluser_vehicle_db        # Database name created in cPanel > MySQL Databases
DB_USER=cpaneluser_vehicle           # DB user created in cPanel
DB_PASSWORD=your-database-password
DB_HOST=localhost                    # almost always "localhost" on cPanel
DB_PORT=                             # blank = default 3306
DB_CONN_MAX_AGE=60

# Optional PostgreSQL instead of MySQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_HOST=/tmp    (or localhost), DB_PORT=5432

# --- Email (real provider later; console printing until then) ------------------
# EMAIL_BACKEND_SERVICE=smtp
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# --- Security toggles -----------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- Admin seeding (used by: python manage.py seed_admin) -----------------------
# Creates/resets the initial superuser. NEVER commit real values to git.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-strong-password
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_FIRST_NAME=Site
SEED_ADMIN_LAST_NAME=Admin

# --- Create-an-admin authorisation code ------------------------------------------
# Unique secret code required in the admin panel "Create New Admin" form.
# Any logged-in staff member who knows this code can create a new admin account.
# Leave empty/unset to DISABLE admin creation entirely. Rotate by changing the
# value in .env and restarting the app. Generate one with e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(16))"
ADMIN_CREATION_CODE=change-me-to-a-random-code
